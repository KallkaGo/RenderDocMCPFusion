include setup.py
recursive-include runtime/headless *
include bridge_extension/bootstrap.py
include bridge_extension/process_lifecycle.py
recursive-include bridge_extension/renderdoc_fusion_bridge *.py *.json
include vendor/gui_client/__init__.py
